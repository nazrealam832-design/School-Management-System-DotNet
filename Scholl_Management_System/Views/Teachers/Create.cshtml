@model School_Management_System.Models.Teacher

@{
    ViewData["Title"] = "Add Teacher";
}

<div class="form-container">

    <div class="form-header">
        <h1>Add Teacher</h1>
        <p>Enter teacher details</p>
    </div>

    <form asp-controller="Teachers"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <div class="form-group">

            <label>Name</label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter teacher name" />

        </div>

        <div class="form-group">

            <label>Email</label>

            <input asp-for="Email"
                   type="email"
                   class="form-control"
                   placeholder="Enter email" />

        </div>

        <div class="form-group">

            <label>Subject</label>

            <input asp-for="Subject"
                   class="form-control"
                   placeholder="Enter subject" />

        </div>

        <div class="form-group">

            <label>Mobile</label>

            <input asp-for="Mobile"
                   class="form-control"
                   placeholder="Enter mobile number" />

        </div>

        <div class="form-group">

            <label>Experience</label>

            <input asp-for="Experience"
                   type="number"
                   class="form-control"
                   placeholder="Enter experience in years" />

        </div>

        <div class="form-buttons">

            <button type="submit"
                    class="btn-primary">
                Add Teacher
            </button>

            <a asp-controller="Teachers"
               asp-action="Index"
               class="btn-secondary">
                Back
            </a>

        </div>

    </form>

</div>