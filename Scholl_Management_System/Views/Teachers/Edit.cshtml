@model School_Management_System.Models.Teacher

@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="form-card">

    <h1>Edit Teacher</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden"
               asp-for="Id" />

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" />
        </div>

        <div class="form-group">
            <label>Subject</label>
            <input asp-for="Subject" />
        </div>

        <div class="form-group">
            <label>Mobile</label>
            <input asp-for="Mobile" />
        </div>

        <div class="form-group">
            <label>Experience</label>
            <input asp-for="Experience" />
        </div>

        <button type="submit"
                class="btn-primary">
            Update Teacher
        </button>

        <a asp-action="Index"
           class="btn-secondary">
            Back
        </a>

    </form>

</div>