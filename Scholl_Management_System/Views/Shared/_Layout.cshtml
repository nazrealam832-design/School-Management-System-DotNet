<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - School Management
    </title>

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <header>

        <nav class="navbar">

            <div class="logo">
                School Management
            </div>

            <div class="nav-links">

                <a asp-controller="Home"
                   asp-action="Index">
                    Dashboard
                </a>

                <a asp-controller="Students"
                   asp-action="Index">
                    Students
                </a>

                <a asp-controller="Teachers"
                   asp-action="Index">
                    Teachers
                </a>

                <a asp-controller="Account"
                   asp-action="Logout">
                    Logout
                </a>

            </div>

        </nav>

    </header>

    <main class="main-content">

        @RenderBody()

    </main>

</body>

</html>