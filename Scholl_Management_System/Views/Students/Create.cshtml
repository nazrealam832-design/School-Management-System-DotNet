@model School_Management_System.Models.Student

@{
    ViewData["Title"] = "Add Student";
}

<div class="form-card">

    <h1>Add Student</h1>

    <form asp-action="Create" method="post">

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="form-group">
            <label>Age</label>
            <input asp-for="Age" />
            <span asp-validation-for="Age"></span>
        </div>

        <div class="form-group">
            <label>Course</label>
            <input asp-for="Course" />
            <span asp-validation-for="Course"></span>
        </div>

        <div class="form-group">
            <label>Mobile</label>
            <input asp-for="Mobile" />
            <span asp-validation-for="Mobile"></span>
        </div>

        <button type="submit"
                class="btn-primary">
            Save Student
        </button>

        <a asp-action="Index"
           class="btn-secondary">
            Back
        </a>

    </form>

</div>