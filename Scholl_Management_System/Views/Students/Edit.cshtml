@model School_Management_System.Models.Student

@{
    ViewData["Title"] = "Edit Student";
}

<div class="form-card">

    <h1>Edit Student</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden"
               asp-for="Id" />

        <div class="form-group">
            <label>Name</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" />
        </div>

        <div class="form-group">
            <label>Age</label>
            <input asp-for="Age" />
        </div>

        <div class="form-group">
            <label>Course</label>
            <input asp-for="Course" />
        </div>

        <div class="form-group">
            <label>Mobile</label>
            <input asp-for="Mobile" />
        </div>

        <button type="submit"
                class="btn-primary">
            Update Student
        </button>

        <a asp-action="Index"
           class="btn-secondary">
            Back
        </a>

    </form>

</div>