@model IEnumerable<School_Management_System.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="page-header">

    <div>
        <h1>Students</h1>

        <p>
            Manage student records
        </p>
    </div>

    <a asp-action="Create"
       class="btn-primary">
        Add Student
    </a>

</div>

<div class="table-container">

    <table>

        <thead>

            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Course</th>
                <th>Mobile</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>@item.Name</td>

                    <td>@item.Email</td>

                    <td>@item.Age</td>

                    <td>@item.Course</td>

                    <td>@item.Mobile</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn-edit">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn-delete">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>